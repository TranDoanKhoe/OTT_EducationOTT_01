{
  "expo": {
    "name": "OTT_Education_Mobile_Khoe",
    "slug": "ott-education-mobile-khoe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "otteducationmobile",
    "userInterfaceStyle": "automatic",
    "extra": {
      "baseUrl": "http://ott-education-balancer-1307761869.ap-southeast-1.elb.amazonaws.com/api",
      "router": {},
      "eas": {
        "projectId": "cfb2d978-a32a-4616-bd1d-c23dfafebd7a"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Ứng dụng cần quyền truy cập microphone để thực hiện cuộc gọi thoại.",
        "NSCameraUsageDescription": "Ứng dụng cần quyền truy cập camera để thực hiện cuộc gọi video."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trandoankhoe.OTT_Education_Mobile",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "hduc203"
  }
}
