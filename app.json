{
  "expo": {
    "name": "OTT_Education_Mobile_Khoe",
    "slug": "ott-education-mobile-khoe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "otteducationmobile",
    "userInterfaceStyle": "automatic",
    "extra": {
      "baseUrl": "http://ott-education-balancer-1307761869.ap-southeast-1.elb.amazonaws.com/api",
      "router": {},
      "eas": {
        "projectId": "cfb2d978-a32a-4616-bd1d-c23dfafebd7a"
      }
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "OTT Education needs microphone access for audio calls and voice messages.",
        "NSCameraUsageDescription": "OTT Education needs camera access for video calls."
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trandoankhoe.OTT_Education_Mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_VISUAL_USER_SELECTED",
        "VIBRATE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "@config-plugins/react-native-webrtc",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow OTT Education to access your photos and videos.",
          "savePhotosPermission": "Allow OTT Education to save chat media to your library.",
          "granularPermissions": [
            "photo",
            "video",
            "audio"
          ]
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "hduc203"
  }
}
